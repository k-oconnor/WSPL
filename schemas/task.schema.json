{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skillforge task proposal",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "task"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "instruction": {
      "type": "string",
      "minLength": 1
    },
    "observable": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "controllable": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      },
      "minItems": 0,
      "uniqueItems": true
    },
    "bindings": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "formula": {
      "$ref": "#/$defs/expr"
    },
    "clock": {
      "const": "motor_tick"
    },
    "stop_requires_acceptance": {
      "const": true
    },
    "status": {
      "const": "example_not_executed"
    }
  },
  "required": [
    "schema_version",
    "kind",
    "task_id",
    "instruction",
    "observable",
    "controllable",
    "bindings",
    "formula",
    "clock",
    "stop_requires_acceptance",
    "status"
  ],
  "additionalProperties": false,
  "$defs": {
    "expr": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "op": {
              "const": "ap"
            },
            "name": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            }
          },
          "required": [
            "op",
            "name"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "true",
                "false"
              ]
            }
          },
          "required": [
            "op"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "not",
                "X",
                "Xw",
                "F",
                "G"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 1,
              "maxItems": 1
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "U",
                "implies"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2,
              "maxItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "op": {
              "enum": [
                "and",
                "or"
              ]
            },
            "args": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/expr"
              },
              "minItems": 2
            }
          },
          "required": [
            "op",
            "args"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
