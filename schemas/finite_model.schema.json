{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Supplied finite skill-effect model",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "clock",
    "states",
    "transitions",
    "commands",
    "assumptions"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "finite_skill_model"
    },
    "clock": {
      "enum": [
        "motor_tick",
        "abstract_tick"
      ]
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "boolean"
        }
      }
    },
    "transitions": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "commands": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
