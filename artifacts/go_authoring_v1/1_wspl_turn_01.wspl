wspl 0.2;
target base=artifact("parent",sha256="{{PARENT_SHA256}}");

const capture_gain=9;
const rescue_gain=15/2;
const self_atari_cost=10;
const contact_cost=11/4;
const territory_cost=7;

edit base as candidate mode=fixed numeric=exact_to_storage {
  W1[0:243,0:512]=0;
  W2[0:512,0:512]=0;
  W3[0:512,0:512]=0;
  W4[0:512,0:512]=0;
  W5[0:512,0:512]=0;
  W6[0:512,0:512]=0;
  W7[0:512,0:82]=0;
  b1[0:512]=0;
  b2[0:512]=0;
  b3[0:512]=0;
  b4[0:512]=0;
  b5[0:512]=0;
  b6[0:512]=0;
  b7[0:82]=0;

  // Temporary spatial coefficient templates:
  // orthogonal, diagonal, straight-two, knight, diagonal-two, straight-three.
  for r in range(9) {
    for c in range(8) {
      W7[9*r+c,9*r+c+1]=1;
      W7[9*r+c+1,9*r+c]=1;
    }
  }
  for r in range(8) {
    for c in range(9) {
      W7[9*r+c,9*r+c+9]=1;
      W7[9*r+c+9,9*r+c]=1;
    }
  }
  for r in range(8) {
    for c in range(8) {
      W7[81+9*r+c,9*r+c+10]=1;
      W7[81+9*r+c+10,9*r+c]=1;
      W7[81+9*r+c+1,9*r+c+9]=1;
      W7[81+9*r+c+9,9*r+c+1]=1;
    }
  }
  for r in range(9) {
    for c in range(7) {
      W7[162+9*r+c,9*r+c+2]=1;
      W7[162+9*r+c+2,9*r+c]=1;
    }
  }
  for r in range(7) {
    for c in range(9) {
      W7[162+9*r+c,9*r+c+18]=1;
      W7[162+9*r+c+18,9*r+c]=1;
    }
  }
  for r in range(7) {
    for c in range(8) {
      W7[243+9*r+c,9*r+c+19]=1;
      W7[243+9*r+c+19,9*r+c]=1;
      W7[243+9*r+c+1,9*r+c+18]=1;
      W7[243+9*r+c+18,9*r+c+1]=1;
    }
  }
  for r in range(8) {
    for c in range(7) {
      W7[243+9*r+c,9*r+c+11]=1;
      W7[243+9*r+c+11,9*r+c]=1;
      W7[243+9*r+c+2,9*r+c+9]=1;
      W7[243+9*r+c+9,9*r+c+2]=1;
    }
  }
  for r in range(7) {
    for c in range(7) {
      W7[324+9*r+c,9*r+c+20]=1;
      W7[324+9*r+c+20,9*r+c]=1;
      W7[324+9*r+c+2,9*r+c+18]=1;
      W7[324+9*r+c+18,9*r+c+2]=1;
    }
  }
  for r in range(9) {
    for c in range(6) {
      W7[405+9*r+c,9*r+c+3]=1;
      W7[405+9*r+c+3,9*r+c]=1;
    }
  }
  for r in range(6) {
    for c in range(9) {
      W7[405+9*r+c,9*r+c+27]=1;
      W7[405+9*r+c+27,9*r+c]=1;
    }
  }

  // h1: stones, direct liberties, and direct-liberty excess above one.
  b1[324:486]=-1;
  for q in range(81) {
    W1[3*q,q]=1;
    W1[3*q+1,81+q]=1;

    W1[3*q,162:243]=-W7[q,0:81];
    W1[3*q+1,162:243]=-W7[q,0:81];
    W1[3*q,162+q]+=4;

    W1[3*q,243:324]=-W7[q,0:81];
    W1[3*q+1,243:324]=-W7[q,0:81];
    W1[3*q+1,243+q]+=4;

    W1[3*q,324:405]=-W7[q,0:81];
    W1[3*q+1,324:405]=-W7[q,0:81];
    W1[3*q,324+q]+=4;

    W1[3*q,405:486]=-W7[q,0:81];
    W1[3*q+1,405:486]=-W7[q,0:81];
    W1[3*q+1,405+q]+=4;

    W1[3*q,486]=-1;
    W1[3*q+1,486]=-1;
    W1[3*q,487]=-1;
    W1[3*q+1,487]=-1;

    W1[3*q,488]=1;
    W1[3*q+1,488]=-1;
    W1[3*q,489]=-1;
    W1[3*q+1,489]=1;
  }
  b1[486]=16;
  b1[487]=1;
  b1[488]=-15/2;
  b1[489]=15/2;
  W1[2,488]=15;
  W1[2,489]=-15;

  // h2 primary safety:
  // direct liberty pairs, adjacent distinct liberties, or a neighbor
  // already possessing at least two direct liberties.
  W2[0:162,0:162]=eye(162);

  W2[162:243,162:243]=2*eye(81)+W7[0:81,0:81];
  W2[243:324,243:324]=2*eye(81)+W7[0:81,0:81];
  W2[324:405,162:243]=3*W7[0:81,0:81];
  W2[405:486,243:324]=3*W7[0:81,0:81];
  W2[0:81,162:243]=64*eye(81);
  W2[81:162,243:324]=64*eye(81);
  b2[162:324]=-66;

  // Secondary safety uses a lower bound on the union of liberties:
  // subtract all empty diagonals to account conservatively for duplicates.
  W2[162:243,324:405]=eye(81)+W7[0:81,0:81];
  W2[243:324,405:486]=eye(81)+W7[0:81,0:81];

  W2[0:81,324:405]=64*eye(81)+W7[81:162,0:81];
  W2[81:162,324:405]=W7[81:162,0:81];
  W2[81:162,405:486]=64*eye(81)+W7[81:162,0:81];
  W2[0:81,405:486]=W7[81:162,0:81];
  b2[324:486]=-69;
  W2[486:490,486:490]=eye(4);

  // h3: ordinary one-step propagation.
  W3[0:162,0:162]=eye(162);
  W3[162:243,162:243]=eye(81)+W7[0:81,0:81];
  W3[324:405,162:243]=eye(81)+W7[0:81,0:81];
  W3[243:324,243:324]=eye(81)+W7[0:81,0:81];
  W3[405:486,243:324]=eye(81)+W7[0:81,0:81];
  W3[0:81,162:243]=512*eye(81);
  W3[81:162,243:324]=512*eye(81);
  b3[162:324]=-512;

  // Two-step propagation is permitted only when the center and every
  // on-board orthogonal neighbor have the required color.
  W3[162:243,324:405]=W7[81:162,0:81]+W7[162:243,0:81];
  W3[324:405,324:405]=W7[81:162,0:81]+W7[162:243,0:81];
  W3[243:324,405:486]=W7[81:162,0:81]+W7[162:243,0:81];
  W3[405:486,405:486]=W7[81:162,0:81]+W7[162:243,0:81];
  W3[0:81,324:405]=1024*(eye(81)+W7[0:81,0:81]);
  W3[81:162,405:486]=1024*(eye(81)+W7[0:81,0:81]);
  b3[324:486]=-5120;
  W3[486:490,486:490]=eye(4);

  // h4: another pair of color-verified propagation circuits.
  W4[0:162,0:162]=eye(162);
  W4[162:243,162:243]=eye(81)+W7[0:81,0:81];
  W4[324:405,162:243]=eye(81)+W7[0:81,0:81];
  W4[243:324,243:324]=eye(81)+W7[0:81,0:81];
  W4[405:486,243:324]=eye(81)+W7[0:81,0:81];
  W4[0:81,162:243]=4096*eye(81);
  W4[81:162,243:324]=4096*eye(81);
  b4[162:324]=-4096;

  W4[162:243,324:405]=W7[81:162,0:81]+W7[162:243,0:81];
  W4[324:405,324:405]=W7[81:162,0:81]+W7[162:243,0:81];
  W4[243:324,405:486]=W7[81:162,0:81]+W7[162:243,0:81];
  W4[405:486,405:486]=W7[81:162,0:81]+W7[162:243,0:81];
  W4[0:81,324:405]=8192*(eye(81)+W7[0:81,0:81]);
  W4[81:162,405:486]=8192*(eye(81)+W7[0:81,0:81]);
  b4[324:486]=-40960;
  W4[486:490,486:490]=eye(4);

  // h5: endangered stones, raw stones, eye evidence, liberty deficit.
  W5[0:81,0:81]=eye(81);
  W5[162:243,0:81]=-eye(81);
  W5[324:405,0:81]=-eye(81);
  W5[81:162,81:162]=eye(81);
  W5[243:324,81:162]=-eye(81);
  W5[405:486,81:162]=-eye(81);

  W5[0:81,162:243]=eye(81);
  W5[81:162,243:324]=eye(81);

  // Eye evidence depends on hostile diagonals, not missing friendly ones.
  W5[0:81,324:405]=2*W7[0:81,0:81];
  W5[81:162,324:405]=-W7[81:162,0:81];
  b5[324:405]=-6;

  W5[0:81,405:486]=W7[0:81,0:81];
  W5[81:162,405:486]=W7[0:81,0:81];
  b5[405:486]=-2;
  W5[486:490,486:490]=eye(4);

  // h6: capture, rescue, self-atari, unsupported contact, value, territory.
  W6[81:162,0:81]=W7[0:81,0:81];
  W6[0:81,81:162]=W7[0:81,0:81];

  W6[405:486,162:243]=eye(81);
  W6[162:243,162:243]=-3/2*W7[0:81,0:81];
  W6[0:81,162:243]=3/2*W7[0:81,0:81];
  W6[81:162,162:243]=-2*W7[0:81,0:81];

  W6[243:324,243:324]=W7[0:81,0:81];
  W6[162:243,243:324]=-W7[0:81,0:81];
  W6[81:162,243:324]=-2*W7[0:81,0:81];

  // Positional value includes direct liberties and mild friendly crowding.
  W6[162:243,324:405]=
      -41/40*W7[0:81,0:81]
      -1/8*W7[81:162,0:81]
      +13/20*W7[162:243,0:81]
      +9/20*W7[243:324,0:81]
      +3/10*W7[324:405,0:81]
      +1/10*W7[405:486,0:81];

  W6[243:324,324:405]=
      3/10*W7[81:162,0:81]
      +9/20*W7[162:243,0:81]
      +7/20*W7[243:324,0:81]
      +1/5*W7[324:405,0:81]
      +1/10*W7[405:486,0:81];

  W6[324:405,324:405]=-18*eye(81);
  b6[324:405]=66;

  // Discourage filling friendly interiors, but exempt nearby rescues
  // and reduce the penalty in contested neighborhoods.
  W6[162:243,405:486]=W7[0:81,0:81]+1/2*W7[81:162,0:81];
  W6[243:324,405:486]=
      -2*W7[0:81,0:81]
      -W7[81:162,0:81]
      -1/2*W7[162:243,0:81];
  W6[0:81,405:486]=-2*W7[0:81,0:81];
  b6[405:486]=-3;
  W6[486:490,486:490]=eye(4);

  for r in range(9) {
    for c in range(9) {
      W6[487,324+9*r+c]=6-3*((r-4)*(r-4)+(c-4)*(c-4))/2;
    }
  }
  for r in range(2,7,4) {
    for c in range(9) {
      W6[486,324+9*r+c]+=1/20;
    }
  }
  for r in range(9) {
    for c in range(2,7,4) {
      W6[486,324+9*r+c]+=1/20;
    }
  }

  // Boundary corrections: orthogonal degree, diagonal degree,
  // complete-star gates, eye thresholds, and candidate liberty counts.
  for q in range(9) {
    b1[162+q]-=1;
    b1[162+72+q]-=1;
    b1[162+9*q]-=1;
    b1[162+9*q+8]-=1;

    b1[243+q]-=1;
    b1[243+72+q]-=1;
    b1[243+9*q]-=1;
    b1[243+9*q+8]-=1;

    b1[324+q]-=1;
    b1[324+72+q]-=1;
    b1[324+9*q]-=1;
    b1[324+9*q+8]-=1;

    b1[405+q]-=1;
    b1[405+72+q]-=1;
    b1[405+9*q]-=1;
    b1[405+9*q+8]-=1;

    b2[324+q]+=2;
    b2[324+72+q]+=2;
    b2[324+9*q]+=2;
    b2[324+9*q+8]+=2;

    b2[405+q]+=2;
    b2[405+72+q]+=2;
    b2[405+9*q]+=2;
    b2[405+9*q+8]+=2;

    b3[324+q]+=1024;
    b3[324+72+q]+=1024;
    b3[324+9*q]+=1024;
    b3[324+9*q+8]+=1024;

    b3[405+q]+=1024;
    b3[405+72+q]+=1024;
    b3[405+9*q]+=1024;
    b3[405+9*q+8]+=1024;

    b4[324+q]+=8192;
    b4[324+72+q]+=8192;
    b4[324+9*q]+=8192;
    b4[324+9*q+8]+=8192;

    b4[405+q]+=8192;
    b4[405+72+q]+=8192;
    b4[405+9*q]+=8192;
    b4[405+9*q+8]+=8192;

    b5[324+q]+=1;
    b5[324+72+q]+=1;
    b5[324+9*q]+=1;
    b5[324+9*q+8]+=1;

    b5[405+q]+=1;
    b5[405+72+q]+=1;
    b5[405+9*q]+=1;
    b5[405+9*q+8]+=1;

    b6[324+q]-=1/2;
    b6[324+72+q]-=1/2;
    b6[324+9*q]-=1/2;
    b6[324+9*q+8]-=1/2;

    b6[405+q]+=1;
    b6[405+72+q]+=1;
    b6[405+9*q]+=1;
    b6[405+9*q+8]+=1;
  }

  b2[324]-=1;
  b2[332]-=1;
  b2[396]-=1;
  b2[404]-=1;
  b2[405]-=1;
  b2[413]-=1;
  b2[477]-=1;
  b2[485]-=1;

  b5[324]+=1;
  b5[332]+=1;
  b5[396]+=1;
  b5[404]+=1;

  // Final policy readout replaces the temporary coefficient templates.
  W7[0:512,0:82]=0;
  W7[0:81,0:81]=capture_gain*eye(81);
  W7[81:162,0:81]=rescue_gain*eye(81);
  W7[162:243,0:81]=-self_atari_cost*eye(81);
  W7[243:324,0:81]=-contact_cost*eye(81);
  W7[324:405,0:81]=eye(81);
  W7[405:486,0:81]=-territory_cost*eye(81);

  for r in range(9) {
    for c in range(9) {
      b7[9*r+c]=-64-((r-4)*(r-4)+(c-4)*(c-4))/20;
    }
  }
  b7[81]=-9/2;
  W7[488,81]=2/25;
  W7[489,81]=-2/25;
}
