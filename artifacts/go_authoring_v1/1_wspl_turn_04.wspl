wspl 0.2;
target base=artifact("parent",sha256="{{PARENT_SHA256}}");

const propagation_gate=4096;
const final_color_gate=8;
const connection_gain=2;

edit base as candidate mode=fixed numeric=exact_to_storage {
  // Immutable templates:
  // A = parent.W6[81:162,0:81], orthogonal adjacency.
  // -D = parent.W6[243:324,0:81], negative diagonal adjacency.

  // Restore explicit own/opponent channels. Singleton threats can be
  // computed directly at h5, so carrying their precursor is unnecessary.
  W2[0:512,0:162]=0;
  b2[0:162]=0;
  W2[0:162,0:162]=eye(162);

  W3[0:512,0:162]=0;
  b3[0:162]=0;
  W3[0:162,0:162]=eye(162);

  W3[0:162,162:486]=0;
  W3[0:81,162:243]=propagation_gate*eye(81);
  W3[0:81,324:405]=propagation_gate*eye(81);
  W3[81:162,243:324]=propagation_gate*eye(81);
  W3[81:162,405:486]=propagation_gate*eye(81);
  b3[162:486]=-propagation_gate;

  // h4 preserves stones and returns the four binary marker absences.
  W4[0:512,0:162]=0;
  b4[0:162]=0;
  W4[0:162,0:162]=eye(162);

  W4[0:162,162:486]=0;
  W4[0:81,162:243]=eye(81);
  W4[0:81,324:405]=eye(81);
  W4[81:162,243:324]=eye(81);
  W4[81:162,405:486]=eye(81);
  b4[162:486]=0;

  W5[0:512,0:512]=0;
  b5[0:512]=0;

  // Let U be the sum of a stone's two marker absences.
  // At stones adjacent to a candidate liberty, U is either zero or one.
  // Every same-color neighbor also knows that liberty's marker.
  // Therefore U + sum_neighbor(U - same_color) removes an alarm
  // whenever a neighboring stone certifies another liberty.

  W5[162:243,0:81]=
      eye(81)+parent.W6[81:162,0:81];
  W5[324:405,0:81]=
      eye(81)+parent.W6[81:162,0:81];
  W5[0:81,0:81]=
      final_color_gate*eye(81)-parent.W6[81:162,0:81];
  b5[0:81]=-final_color_gate;

  W5[243:324,81:162]=
      eye(81)+parent.W6[81:162,0:81];
  W5[405:486,81:162]=
      eye(81)+parent.W6[81:162,0:81];
  W5[81:162,81:162]=
      final_color_gate*eye(81)-parent.W6[81:162,0:81];
  b5[81:162]=-final_color_gate;

  // Raw stones retain their established h5 locations.
  W5[0:81,162:243]=eye(81);
  W5[81:162,243:324]=eye(81);

  // Exact opposing singleton/two-liberty detector.
  // Reconstruct 3-liberties and subtract the atari singleton case.
  W5[0:81,324:405]=parent.W6[81:162,0:81];
  W5[81:162,324:405]=
      8*eye(81)-8*parent.W6[81:162,0:81];
  W5[243:324,324:405]=-2*eye(81);
  W5[405:486,324:405]=-2*eye(81);
  b5[324:405]=parent.b6[162:243]-7;

  // Connection evidence:
  // friendly orthogonal neighbors, discounted for diagonal redundancy
  // and for endangered stones already covered by the rescue circuit.
  W5[0:81,405:486]=
      parent.W6[81:162,0:81]
      +1/2*parent.W6[243:324,0:81];
  W5[162:243,405:486]=-1/2*parent.W6[81:162,0:81];
  W5[324:405,405:486]=-1/2*parent.W6[81:162,0:81];
  b5[405:486]=-1;

  W5[486:490,486:490]=eye(4);

  // Add connections to the existing positive-offset value accumulator.
  // Capture, rescue, self-atari, eye, territory and pass readouts remain.
  W6[405:486,0:512]=0;
  W6[405:486,324:405]=connection_gain*eye(81);
}
