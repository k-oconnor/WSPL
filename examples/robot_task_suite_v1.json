{
  "format": "skillforge.robot_tasks.v1",
  "clock_hz": 20,
  "status": "inspected_design_only",
  "skills": {
    "approach_contact": {
      "status": "planned",
      "meaning": "Reach a validated contact-ready pose, beyond the completed standoff pilot."
    },
    "close": {
      "status": "planned",
      "meaning": "Establish bilateral object contact independently of lifting."
    },
    "lift": {
      "status": "planned",
      "meaning": "Raise the bound object with independently observed maintained grasp."
    },
    "transport": {
      "status": "planned",
      "meaning": "Move a held object to a bound destination without unintended release."
    },
    "lower": {
      "status": "planned",
      "meaning": "Lower to a physically supported placement."
    },
    "release": {
      "status": "planned",
      "meaning": "Release only at an allowed supported destination."
    },
    "retreat": {
      "status": "planned",
      "meaning": "Clear the placed object without displacing it."
    },
    "open_drawer": {
      "status": "planned",
      "meaning": "Establish handle contact and open the bound articulated drawer."
    },
    "close_drawer": {
      "status": "planned",
      "meaning": "Close a drawer without trapping a manipulated object or gripper."
    },
    "close_door": {
      "status": "planned",
      "meaning": "Close an articulated appliance door after safe placement."
    },
    "stack": {
      "status": "planned",
      "meaning": "Place one object on another with stable support."
    },
    "hold": {
      "status": "planned",
      "meaning": "Maintain the independently observed held condition over elapsed motor ticks."
    },
    "route_around": {
      "status": "planned",
      "meaning": "Select and execute a route around physical obstacle geometry."
    },
    "route_over": {
      "status": "planned",
      "meaning": "Select and execute a route above physical obstacle geometry."
    },
    "recover_contact": {
      "status": "planned",
      "meaning": "Locate and reacquire a recoverably dropped object."
    }
  },
  "capabilities": {
    "motor12": {
      "status": "available",
      "meaning": "Twelve measured bound-object/target channels and four OSC outputs; structured perception."
    },
    "goal_binding": {
      "status": "available",
      "meaning": "Supply one fixed world target; does not choose grasp poses."
    },
    "object_rebinding": {
      "status": "planned",
      "meaning": "Executor binds distinct object IDs and targets per invocation, without changing skill weights."
    },
    "physical_executor": {
      "status": "planned",
      "meaning": "Execute primitive sequences with invocation IDs, failure handling and observed phase progression."
    },
    "pickup_observer": {
      "status": "planned",
      "meaning": "Calibrated elevation/contact/support evidence for actual pickup, including reset of stale status."
    },
    "placement_observer": {
      "status": "planned",
      "meaning": "Stable geometry containment/support plus gripper release and retreat; no target-distance shortcut."
    },
    "collision_observer": {
      "status": "planned",
      "meaning": "Monitor forbidden robot/held-object contacts and swept clearance at physics substeps, with phase-dependent allowed contacts."
    },
    "contact_orientation_interface": {
      "status": "planned",
      "meaning": "Explicit grasp orientation/object geometry interface; fixed-orientation sufficiency must be established before reusing motor12."
    },
    "articulation_interface": {
      "status": "planned",
      "meaning": "Named joint/handle pose channels and calibrated open/closed thresholds; new declared interface version."
    },
    "articulation_observer": {
      "status": "planned",
      "meaning": "Observed joint transition and clearance before/after articulated motion."
    },
    "stack_observer": {
      "status": "planned",
      "meaning": "Stable object-on-object support, including support retention through later motion."
    },
    "obstacle_scene_interface": {
      "status": "planned",
      "meaning": "Declared obstacle geometry/poses visible to the route selector/controller; no hidden navigation inside motor adapter."
    },
    "route_observer": {
      "status": "planned",
      "meaning": "Independent path gate and swept held-body clearance; labels alone do not prove route feasibility."
    },
    "accessibility_observer": {
      "status": "planned",
      "meaning": "Verify target grasp access and whether blocker removal was physically necessary."
    },
    "event_clock": {
      "status": "planned",
      "meaning": "Invocation-scoped outcome pulses and consecutive 20 Hz timestamps, including terminal STOP."
    },
    "hold_observer": {
      "status": "planned",
      "meaning": "Observe held-object/contact/support state on each required dwell tick."
    },
    "fault_injection": {
      "status": "planned",
      "meaning": "Logged one-shot recoverable perturbation with visible state consequences, paired timing across methods."
    },
    "progress_observer": {
      "status": "planned",
      "meaning": "Check already-completed objects remain at destination and count unnecessary repeated work."
    }
  },
